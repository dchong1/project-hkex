# Copy to .env and fill in values (never commit .env)

NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...

# --- Summarizer (default: none = zero LLM API cost) ---
# SUMMARIZER=none
# Or use LLM_PROVIDER (alias for SUMMARIZER)

# Grok (xAI): set SUMMARIZER=grok or leave unset when GROK_API_KEY is present
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-3-mini

# OpenAI-compatible (Ollama, Groq, etc.): SUMMARIZER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

# Optional: save HTML when the fetcher errors (local debugging)
# DEBUG_SAVE_HTML=1
